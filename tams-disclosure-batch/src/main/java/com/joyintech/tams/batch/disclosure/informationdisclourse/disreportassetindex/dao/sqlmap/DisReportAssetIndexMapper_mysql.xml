	<!-- 查询reader返回数据 - 指定帐套的核算主体和TA产品   -->
	<select id="getDisReportAssetIndexVal" resultType="com.joyintech.tams.batch.disclosure.informationdisclourse.disreportassetindex.dto.DisReportAssetIndexResult" parameterType="java.util.Map">
		SELECT
		   *
		FROM REP_ASSET_INDEX 
		WHERE 1=1
		<if test="prodid != null and prodid != '' ">
                AND PROD_ID in (
		  	<foreach item="item" index="index" collection="prodid"  open="(" separator="," close=")">
	        	#{item}
	       	</foreach>
	       	)
        </if>
       	AND VALUE_DATE  <![CDATA[ <=]]> #{endDate,jdbcType=DATE}
       	AND VALUE_DATE  <![CDATA[ >= ]]> #{startDate,jdbcType=DATE}
	</select>
	
	
	
	
	    
  <!-- 删除表【REP_PROD_INDEX】数据 -->
    <update id="updateRepoAssetIndex" parameterType="java.util.Map" >
    	UPDATE REP_ASSET_INDEX SET END_DAYS_2 = NULL
    	WHERE 1=1
    	<if test="prodid != null and prodid != '' ">
                AND PROD_ID in (
		  	<foreach item="item" index="index" collection="prodid"  open="(" separator="," close=")">
	        	#{item}
	       	</foreach>
	       	)
        </if>
       	AND VALUE_DATE  <![CDATA[ <=]]> #{endDate,jdbcType=DATE}
       	AND VALUE_DATE  <![CDATA[ >= ]]> #{startDate,jdbcType=DATE}
    </update>
    
     <!-- 删除表【REP_PROD_INDEX】数据 -->
    <update id="updateRepoAssetIndexAll" parameterType="com.joyintech.tams.batch.disclosure.informationdisclourse.disreportassetindex.dto.DisReportAssetIndexResult" >
    	UPDATE REP_ASSET_INDEX SET END_DAYS_2 = #{endDays2,jdbcType=DECIMAL}
    	WHERE prod_ID =#{prodId,jdbcType=VARCHAR}
       	AND VALUE_DATE  = #{valueDate,jdbcType=DATE}
    </update>
    
    
    
   
	


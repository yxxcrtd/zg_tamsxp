<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.component.business.evaluation.dao.BokPositionPrdReferenceMapper_mysql">
    <select id="getBokPositionPrdList" resultType="com.joyintech.tams.component.business.evaluation.dto.BokPositionPrd">
        select * from BOK_POSITION_PRD
        <where>
            <if test="startDate!=null and startDate != ''">
                AND CDATE >= STR_TO_DATE(#{startDate},'%Y-%m-%d')
            </if>
            <if test="endDate!=null and endDate != ''">
                AND STR_TO_DATE(#{endDate},'%Y-%m-%d') >= CDATE
            </if>
            <if test="finProdId!=null and finProdId!=''">
                AND FINPROD_ID = #{finProdId}
            </if>
            <if test="branch!=null and branch!=''">
                AND BRANCH = #{branch}
            </if>
        </where>
    </select>
</mapper>

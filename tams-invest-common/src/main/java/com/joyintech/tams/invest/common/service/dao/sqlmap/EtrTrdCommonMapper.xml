<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.invest.common.service.dao.EtrTrdCommonMapper">

    <select id="getPtlAcctInfo" resultType="Map">
        select t.ACCT_NO
        from PTL_CAPACCT_INFO t
        where t.PORTFOLIO_ID = #{portfolioId}
    </select>

</mapper>
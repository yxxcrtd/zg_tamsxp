    <!--add by zhangliang 20201010 start-->
    <select id="queryChbPrdDeclareSubByRegCode" resultType="com.joyintech.tams.common.base.entity.ChbPrdDeclareSub">
        select
        REGIST_SEQNO registSeqno,
        RAISE_PSTRDATE raisePstrdate,
        RAISE_PENDDATE raisePenddate,
        OPERATE_MODE operateMode,
        SALE_AREA saleArea
        from
        CHB_PRD_DECLARE_SUB
        <where>
            <if test="prodId != null and prodId != ''">
                and PROD_INS_ID = #{prodId}
            </if>
            <if test="regCode != null and regCode != ''">
                and REG_CODE = #{regCode}
            </if>
        </where>
    </select>

    <select id="queryChbBotAstPosByInfo" parameterType="com.joyintech.tams.common.base.entity.ChbBotAstPositionSub" resultType="com.joyintech.tams.common.base.entity.ChbBotAstPositionSub">
        select
              ASSET_CODE assetCode,
              TOTAL_NUM totalNum,
              ISSUE_AMT issueAmt,
              UNINVEST_CASH uninvestCash
        from
            CHB_BOT_AST_POS
        where PLAN_ASSET_ID = #{planAssetId}
          and POS_DATE = #{posDate}
          and ASSET_CODE != #{assetCode}
    </select>
    <select id="genChbPrdDeclareSub1ByProdInsId" resultType="java.lang.String">
        SELECT
            PROD_INS_ID
        FROM
            ${tableName}
        WHERE
            PROD_NAME = #{prodName}
          AND cast(PROD_STAGE as char) = #{prodStage}
          AND PROD_INS_ID != #{prodInsId}
 	</select>

    <select id="genChbPrdDeclareSub2ByProdInsId" resultType="java.lang.String">
        SELECT
            1
        FROM
            CHB_PRD_DECLARE_SUB
        WHERE
            PROD_NAME = #{prodName}
          AND cast(PROD_STAGE as char) = #{prodStage}
          AND PROD_INS_ID != #{prodInsId, jdbcType=VARCHAR}
          AND SEND_STATUS IN ('02', '03')
 	</select>

    <select id="getChbPrdIssueSubByProdId"  resultType="com.joyintech.tams.common.base.entity.ChbPrdIssueSub">
   	select
   	RAISE_VDATE  raiseVdate,
    PRD_VDATE prdVdate
   	from  CHB_PRD_ISSUE_SUB
   	where  PROD_ID = #{prodId,jdbcType=VARCHAR}
   	</select>
    <delete id="deleteChbInvestTradeErrorData">
        delete from CHB_INVEST_TRADE_ERRODATA where PROD_ID = #{prodId} and TRADE_CODE = #{tradeCode} and ASSET_CODE = #{assetCode}
    </delete>
    <delete id="deleteChbPrdBaseInfoErrorData">

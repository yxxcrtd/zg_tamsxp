<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.common.svreport.palatformDate.dao.SvrPlatformDateImplMapper_mysql">
	<select id="getSysDate" resultType="java.util.Date">
		select CUR_DATE from SYS_DATE
	</select>
	<select id="getDbDate" resultType="java.util.Date">
		select NOW() from dual
	</select>
	<update id="updateSysDate" parameterType="java.util.Date">
		update SYS_DATE set CUR_DATE=#{newDate, jdbcType=DATE}
	</update>
</mapper>

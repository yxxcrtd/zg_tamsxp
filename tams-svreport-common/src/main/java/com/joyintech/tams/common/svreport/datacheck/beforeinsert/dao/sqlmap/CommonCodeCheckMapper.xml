   <select id="queryChbPrdDeclareSubByRegCode" resultType="com.joyintech.tams.common.base.entity.ChbPrdDeclareSub">
      select
             A.REGIST_SEQNO registSeqno,
             A.RAISE_PSTRDATE raisePstrdate,
             A.RAISE_PENDDATE raisePenddate,
             A.OPERATE_MODE operateMode,
             A.SALE_AREA saleArea,
             A.IVSTORIENTATION  ivstorientation
      from
            CHB_PRD_DECLARE_SUB A
         LEFT JOIN CHB_PRDRESIST_CODE B
         	ON  A.PROD_ID = B.PRODID
      <where>
          <if test="prodId != null and prodId != ''">
              and A.PROD_INS_ID = #{prodId}
          </if>
          <if test="regCode != null and regCode != ''">
              and B.REG_CODE = #{regCode}
          </if>
      </where>
   </select>

   <select id="queryChbPrdresistCodeByRegCode" resultType="com.joyintech.tams.common.base.entity.ChbPrdresistCode">

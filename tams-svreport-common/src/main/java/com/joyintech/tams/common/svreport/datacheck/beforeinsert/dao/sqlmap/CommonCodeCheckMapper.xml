    <select id="checkSalerCredentNo" resultType="integer" parameterType="java.lang.String" >
        select
        count(*)
        from
        CHB_SALER_IDEN_INFO
        where
        STATUS = 'E'
        <if test="salerCredentType != null and salerCredentType != ''">
            and SALER_CREDENT_TYPE = #{salerCredentType,jdbcType=VARCHAR}
        </if>
        <if test="salerOtherCredentName != null and salerOtherCredentName != ''">
            and SALER_OTHER_CREDENT_NAME = #{salerOtherCredentName,jdbcType=VARCHAR}
        </if>
        <if test="salerCredentNo != null and salerCredentNo != ''">
            and SALER_CREDENT_NO = #{salerCredentNo,jdbcType=VARCHAR}
        </if>
    </select>


<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.joyintech</groupId>
        <artifactId>tams-parent</artifactId>
        <version>0.0.4</version>
    </parent>
    <artifactId>tams-risk</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>framework-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>framework-dtx</artifactId>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>joyintech-tools</artifactId>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>joyintech-workflow</artifactId>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-common</artifactId>
            <version>2.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.googlecode.aviator</groupId>
            <artifactId>aviator</artifactId>
            <version>5.3.1</version>
        </dependency>

        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>tams-valuation-analysis</artifactId>
            <version>0.0.5</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- 打包源代码插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.4</version>
                <configuration>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>

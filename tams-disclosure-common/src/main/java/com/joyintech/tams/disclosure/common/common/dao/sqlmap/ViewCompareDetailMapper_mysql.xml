<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.joyintech.tams.disclosure.common.common.dao.ViewCompareDetailMapper_mysql">
    <select id="selectDetail" resultType="java.util.Map">
        select
        *
        from ${tableName}
        <where>
            <if test="condition != null">
                <foreach collection="condition" open="" close="" separator=" AND " item="item">
                    ${item.field} = ${item.value}
                </foreach>
            </if>
        </where>
        ${order}
    </select>
</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<Workbook filePath="AssetInfoDetail.xlsx" name="资产要素维护">
	<Worksheet dataStart="1" javaBean="com.joyintech.tams.svreport.chb.assetinfodetail.dto.AssetInfoDetailDto">
		<Row>
			<Cell order="1" name="数据状态">dataStatusStr</Cell>
			<Cell order="2" name="资产代码">assetCode</Cell>
			<Cell order="3" name="资产名称">assetName</Cell>
			<Cell order="4" name="资产一级类型">orgAssetType1Str</Cell>
			<Cell order="5" name="资产二级分类">orgAssetType2Str</Cell>
			<Cell order="6" name="起息日">vDateStr</Cell>
			<Cell order="7" name="到期日">mDateStr</Cell>
			<Cell order="8" name="资产/负债类别">assetTypeStr</Cell>
			<Cell order="9" name="资产/负债二级类别">assetType2Str</Cell>
			<Cell order="10" name="错误信息">errMsg</Cell>
		</Row>
	</Worksheet>
</Workbook>
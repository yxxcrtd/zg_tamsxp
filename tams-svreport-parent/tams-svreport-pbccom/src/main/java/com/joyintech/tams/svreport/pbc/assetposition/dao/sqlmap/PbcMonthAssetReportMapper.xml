    PMAP.POSUUID, PMAP.PRODID, PMAP.ORG_CODE, PMAP.POSITION_TYPE, PMAP.CHL_ID, PMAP.ASSET_CODE, PMAP.ASSET_TYPE1, PMAP.ASSET_TYPE2,

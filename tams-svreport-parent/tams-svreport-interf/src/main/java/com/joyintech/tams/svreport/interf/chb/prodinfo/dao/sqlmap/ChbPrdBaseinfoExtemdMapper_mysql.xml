    <select id="selectProdYieldInfo" parameterType="java.util.Map"
            resultType="com.joyintech.tams.svreport.interf.chb.prodinfo.dto.ChbPrdBaseinfoExtend">
	  	select p.finprod_id,
		       p.p_finprod_id,
		       p.finprod_market_id,
		       p.vdate,
		       b.eff_date,
		       b.rate_type,
		       b.rate,
		       b.index_id,
		       b.coefficient,
		       b.spread_rate
		  from fin_product p
		  left join FIN_BASE_RULE_INFO b
		    on p.finprod_id = b.base_rule_id
		where   p.vdate = b.eff_date /*生效日等于产品起息日*/
			and p.profit_type !='02'/*过滤净值型产品*/
			and ifnull(p.UPDATE_TIME,p.CREATE_TIME) > #{batchTime,jdbcType=TIMESTAMP}
  </select>

    <select id="selectProdInvestFeeRate" parameterType="java.util.Map"
            resultType="com.joyintech.tams.svreport.interf.chb.prodinfo.dto.ChbPrdBaseinfoExtend">
		select p.finprod_id,
		       p.p_finprod_id,
		       p.finprod_market_id,
		       ifnull(b.yield,0) * 100 as yield
		  from fin_product p
		  left join FIN_CASH_CALC_RULE b
		    on p.finprod_id = b.finprod_id
		  left join FIN_CASH_INFO c
			on b.cash_id = c.cash_id
		 where   c.cash_type_1 = '03'
			 and c.cash_type_2 = 'C03'
			 and b.is_initial = 'Y'/*是否初始利率*/
			 and c.finprod_id like 'F16_%'
			 and ifnull(p.UPDATE_TIME,p.CREATE_TIME) > #{batchTime,jdbcType=TIMESTAMP}
  </select>

        REGIST_SEQNO,
        PROD_ID,
        ISSUE_PARTY_ID,
        PROD_REGIST_CODE,
        VALUE_CCY,
        BANK_IMP_INT,
        DATE_FORMAT(VDATE,'%Y-%m-%d') VDATE,

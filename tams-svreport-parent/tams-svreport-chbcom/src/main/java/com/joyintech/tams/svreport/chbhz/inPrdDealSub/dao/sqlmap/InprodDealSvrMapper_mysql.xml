    <select id="genChbPrdDealSubTmpList"  resultMap="BaseResultMap">
        select  pc.PRODID PROD_ID,rs.*
        from CHB_PRD_DEAL_SUB_TMP rs
        INNER JOIN CHB_PRDRESIST_CODE pc on rs.PROD_REGIST_CODE = pc.REG_CODE
        where  1=1
        and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND pc.PRODID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="genChbPrdDealSubList"  resultMap="ProdPersonDealDtoRM">
        select * from CHB_PRD_DEAL_SUB
        where 1=1
        and  SEND_STATUS  in ('02','03')
        <if test="keylist != null and keylist.size() > 0">
            AND concat_ws('|',PROD_ID,DATE_FORMAT(MDATE,'%Y-%m-%d'))  IN
            <trim suffixOverrides=" OR concat_ws('|',PROD_ID,DATE_FORMAT(MDATE,'%Y-%m-%d')) IN ()">
                <foreach collection='keylist' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR concat_ws('|',PROD_ID,DATE_FORMAT(MDATE,'%Y-%m-%d')) IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select  id="getOpertModeByPordId"  resultType="java.lang.String">
        select  t.OPERATE_MODE from
            (select  row_number() over(partition by prod_id order by update_time desc) my_rank,OPERATE_MODE
             from CHB_PRD_DECLARE_SUB
             where  prod_id=#{prodId,jdbcType=VARCHAR}
               and  status in ('01','02'))t where t.my_rank=1
    </select>


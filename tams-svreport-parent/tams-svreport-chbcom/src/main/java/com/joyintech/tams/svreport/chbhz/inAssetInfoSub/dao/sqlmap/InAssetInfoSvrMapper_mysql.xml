  select  * from  CHB_ASSET_INFO_TMP
  where  1=1
  and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}
 </select>
    <select id="genChbAssetInfoSubList"  resultMap="ChbAssetSubDtoRMRegist">
        select * from CHB_ASSET_INFO_SUB
        where 1=1
        and  SEND_STATUS  in ('02','03')
        <if test="keylist != null and keylist.size() > 0">
            AND ASSET_CODE IN
            <trim suffixOverrides=" OR ASSET_CODE IN ()">
                <foreach collection='keylist' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR ASSET_CODE IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.svreport.chb.common.dao.ChbCustomerNumCheckMapper_mysql" >

    <select id="getraiseCustNum"  resultType="com.joyintech.tams.common.base.entity.ChbPrdCustNumIfo">
        SELECT
        PROD_ID  prdCode,
        SINGLE_TOTAL+LEGAL_TOTAL+UNLEGAL_TOTAL  CustHeldNum
        FROM  CHB_PRD_RAISETOT_SUB
        WHERE 1 = 1
        <!-- prodId不为空则表示有指定产品代码，不需要再根据条件进行二次过滤，如果为空则表示数据检查批处理调用，需要过滤无效数据 -->
        <choose>
            <when test="prodId != null and prodId != ''">
                and PROD_ID = #{prodId}
            </when>
            <otherwise>
                AND STATUS_DATE <![CDATA[<=]]> #{checkDate,jdbcType=DATE}
                AND SEND_STATUS = '01'
            </otherwise>
        </choose>
    </select>

    <select id="getraiseCustNumThree" resultType="com.joyintech.tams.common.base.entity.ChbPrdCustNumIfo">
        SELECT
        a.ACCOUNT prdCode,
        count(INDENTIFY_MARK) CustHeldNum
        from
        (
        select
        ACCOUNT ,
        INDENTIFY_MARK,
        STATUS,
        ROW_NUMBER() over( partition BY ACCOUNT, INDENTIFY_MARK ORDER BY UPDATE_TIME DESC) AS rowno
        from
        CHB_EQUDET
        <where>
            1 = 1
            <if test="prodIdList != null and prodIdList.size() > 0">
                AND ACCOUNT IN
                <trim suffixOverrides=" OR ACCOUNT IN ()">
                    <foreach collection='prodIdList' open='(' close=')' index='index'
                             item='item'>
                        <if test="index != 0">
                            <choose>
                                <when test="index % 1000 == 999">) temp OR ACCOUNT IN (</when>
                                <otherwise>,</otherwise>
                            </choose>
                        </if>
                        #{item}
                    </foreach>
                </trim>
            </if>
            AND BUSI_TYPE='01'
        </where>
        ) a
        WHERE
        rowno = 1 AND STATUS != 'D'
        group by a.ACCOUNT
    </select>
</mapper>
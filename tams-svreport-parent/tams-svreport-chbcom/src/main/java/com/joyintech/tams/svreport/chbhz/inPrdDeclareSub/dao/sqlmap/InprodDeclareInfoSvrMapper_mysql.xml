    <select id="genChbPrdDeclareSubTmpList"  resultMap="BaseResultMap">
        select  * from  CHB_PRD_DECLARE_SUB_TMP
        where  1=1
        and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND PROD_INS_ID IN
            <trim suffixOverrides=" OR PROD_INS_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_INS_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="genChbPrdDeclareSubList"  resultMap="PerProDeclareRegDtoRM">
        select * from CHB_PRD_DECLARE_SUB
        where 1=1
        <!-- add by zhangliang 20210507 先全量查询，代码去处理 目的是为了获取九大附件相关信息 start -->
        <!-- and  SEND_STATUS  in ('02','03') -->
        <!-- add by zhangliang 20210507 先全量查询，代码去处理 目的是为了获取九大附件相关信息 end -->
        <if test="keylist != null and keylist.size() > 0">
            AND PROD_INS_ID IN
            <trim suffixOverrides=" OR PROD_INS_ID IN ()">
                <foreach collection='keylist' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_INS_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>

    <select id="genChbPrdDeclareSubAllList"  resultMap="PerProDeclareRegDtoRM">
  select * from CHB_PRD_DECLARE_SUB
    where 1=1
    and  SEND_STATUS  in ('02','03')
 </select>

    <select id="genChbPrdDeclareSubTmp1ByProdInsId" resultMap="BaseResultMap">
 select  st.*  from  CHB_PRD_DECLARE_SUB_TMP  st
where PROD_INS_ID  =#{prodInsId,jdbcType=VARCHAR}
and  exists (
select 1 from CHB_PRD_DECLARE_SUB_TMP  stp
where  st.PROD_NAME=stp.PROD_NAME and  st.PROD_STAGE=stp.PROD_STAGE
and  PROD_INS_ID  !=#{prodInsId,jdbcType=VARCHAR}
)
 </select>

    <select id="genChbPrdDeclareSubTmp2ByProdInsId" resultMap="BaseResultMap">
 select  st.*  from  CHB_PRD_DECLARE_SUB_TMP  st
where PROD_INS_ID  =#{prodInsId,jdbcType=VARCHAR}
and  exists (
select 1 from CHB_PRD_DECLARE_SUB  stp
where  st.PROD_NAME=stp.PROD_NAME and  st.PROD_STAGE=stp.PROD_STAGE
and  PROD_INS_ID  !=#{prodInsId,jdbcType=VARCHAR}
and stp.SEND_STATUS  in ('02','03')
)
 </select>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.joyintech.tams.svreport.chbhz.inPrdEndSub.dao.InprodEndInfoSvrMapper_mysql" >
    <resultMap id="BaseResultMap" type="com.joyintech.tams.common.base.entity.ChbPrdEndSubTmp" >
        <result column="PROD_ID" property="prodId" jdbcType="VARCHAR" />
        <result column="MDATE" property="mdate" jdbcType="DATE" />
        <result column="ISSUE_PARTY_ID" property="issuePartyId" jdbcType="VARCHAR" />
        <result column="PROFIT" property="profit" jdbcType="DECIMAL" />
        <result column="CUSTOM_PROFIT" property="customProfit" jdbcType="DECIMAL" />
        <result column="CUSTOM_AMT" property="customAmt" jdbcType="DECIMAL" />
        <result column="CUS_YEAR_YIELD" property="cusYearYield" jdbcType="DECIMAL" />
        <result column="PRD_YEAR_YIELD" property="prdYearYield" jdbcType="DECIMAL" />
        <result column="CUST_FEE_IN" property="custFeeIn" jdbcType="DECIMAL" />
        <result column="MAN_FEE_IN" property="manFeeIn" jdbcType="DECIMAL" />
        <result column="COU_FEE_IN" property="couFeeIn" jdbcType="DECIMAL" />
        <result column="OTHER_FEE_IN" property="otherFeeIn" jdbcType="DECIMAL" />
        <result column="CUST_FEE_OUT" property="custFeeOut" jdbcType="DECIMAL" />
        <result column="MAN_FEE_OUT" property="manFeeOut" jdbcType="DECIMAL" />
        <result column="COU_FEE_OUT" property="couFeeOut" jdbcType="DECIMAL" />
        <result column="ADV_FEE_OUT" property="advFeeOut" jdbcType="DECIMAL" />
        <result column="OTHER_FEE_OUT" property="otherFeeOut" jdbcType="DECIMAL" />
        <result column="CUSTOM_QTY" property="customQty" jdbcType="DECIMAL" />
        <result column="PROD_REGIST_CODE" property="prodRegistCode" jdbcType="VARCHAR" />
        <result column="ORG_CODE" property="orgCode" jdbcType="VARCHAR" />
        <result column="DEPT_CODE" property="deptCode" jdbcType="VARCHAR" />
        <result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
        <result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
        <result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
        <result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
        <result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />
        <result column="ROW_DATE" property="rowDate" jdbcType="DATE" />
        <result column="DATA_SOURCE" property="dataSource" jdbcType="VARCHAR" />
        <result column="STATUS" property="status" jdbcType="VARCHAR" />
    </resultMap>

    <select id="genChbPrdEndSubTmpList"  resultMap="BaseResultMap">
        select  pc.PRODID PROD_ID,rs.*
        from  CHB_PRD_END_SUB_TMP rs
        INNER JOIN CHB_PRDRESIST_CODE pc on rs.PROD_REGIST_CODE = pc.REG_CODE
        where  1=1
        and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND pc.PRODID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="genChbPrdEndSubList"  resultType="com.joyintech.tams.svreport.chb.prodterminationregist.dto.ProdTerminationRegist001Dto">
        select REGIST_SEQNO  registSeqno,
        PROD_ID  prodId,
        MDATE  mdate,
        ISSUE_PARTY_ID issuePartyId,
        PROFIT ,
        CUSTOM_PROFIT customProfit,
        CUSTOM_PROFIT_ORI  customProfitOri ,
        CUSTOM_AMT_ORI customAmtOri,
        CUSTOM_AMT customAmt,
        CUS_YEAR_YIELD cusYearYield,
        PRD_YEAR_YIELD prdYearYield,
        CUST_FEE_IN custFeeIn,
        MAN_FEE_IN  manFeeIn,
        COU_FEE_IN  couFeeIn,
        OTHER_FEE_IN otherFeeIn,
        CUST_FEE_OUT CUST_FEE_OUT,
        MAN_FEE_OUT  manFeeOut,
        <!-- modify by dubaojun 2020-10-31 映射字段不正确修改 start -->
        COU_FEE_OUT  couFeeOut,
        <!-- modify by dubaojun 2020-10-31 映射字段不正确修改 end -->
        ADV_FEE_OUT advFeeOut,
        OTHER_FEE_OUT  otherFeeOut,
        SEND_STATUS   sendStatus,
        SUBMIT_FEEDBACK_STATUS  submitFeedbackStatus,
        STATUS_DATE  statusDate,
        STATUS ,
        CREATE_USER  createUser,
        CREATE_DEPT createDept,
        CREATE_TIME createTime,
        UPDATE_USER updateUser,
        UPDATE_TIME updateTime,
        SUBMIT_TIME submitTime,
        CHB_SUBMIT_DEADLINE chbSubmitDeadline,
        SUBMIT_DEADLINE submitDeadline,
        ORG_CODE  orgCode,
        DEPT_CODE deptCode,
        CUSTOM_QTY  customQty
        from CHB_PRD_END_SUB
        where 1=1
        and  SEND_STATUS  in ('02','03')
        <if test="keylist != null and keylist.size() > 0">
            AND PROD_ID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='keylist' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>

</mapper>
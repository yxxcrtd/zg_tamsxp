    <select id="genChbPrdRaisetotSubTmpList"  resultMap="BaseResultMap">
        select  pc.PRODID,rs.* from  CHB_PRD_RAISETOT_SUB_TMP rs left join CHB_PRDRESIST_CODE pc on rs.PROD_REGIST_CODE = pc.REG_CODE
        where  1=1
        and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}

        <!--add by zhangliang 20201022 从上游数据到tmp表新加字段PROD_ID-->
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND pc.PRODID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="genChbPrdRaisetotSubList"  resultMap="RaiseTotalRegist001DtoRM">
        select * from CHB_PRD_RAISETOT_SUB
        where 1=1
        and  SEND_STATUS  in ('02','03')
        <if test="keylist != null and keylist.size() > 0">

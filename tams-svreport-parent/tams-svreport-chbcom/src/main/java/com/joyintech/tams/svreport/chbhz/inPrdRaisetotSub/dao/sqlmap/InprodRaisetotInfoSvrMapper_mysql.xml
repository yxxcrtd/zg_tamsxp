                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_REGIST_CODE IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="selectRegistCodeByid" parameterType="java.util.List"  resultType="java.lang.String">

    <select id="genChbPrdIssueSubTmpList"  resultMap="BaseResultMap">
        select  * from  CHB_PRD_ISSUE_SUB_TMP
        where  1=1
        and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND PROD_ID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="genChbPrdIssueSubList"  resultMap="ProdPersonIssue001DtoRM">

                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID||'|'||TRADE_CODE||'|'||ASSET_CODE||'|'||CUR_ASSET_TYPE IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>


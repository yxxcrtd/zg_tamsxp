    <select id="genChbInvestTradeSubTmpList"  resultMap="BaseResultMap">
        select
        pc.PRODID PROD_ID,rs.*
        from  CHB_INVEST_TRADE_SUB_TMP rs
        INNER JOIN CHB_PRDRESIST_CODE pc on rs.PROD_REGIST_CODE = pc.REG_CODE
        where  1=1
        and   DATE_FORMAT(ROW_DATE,'%Y-%m-%d') = #{batchdate,jdbcType = VARCHAR}
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND pc.PRODID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
    <select id="genChbInvestTradeSubList"  resultMap="InvestTradeRegist001DtoRM">
        select * from CHB_INVEST_TRADE_SUB
        where 1=1
        and  SEND_STATUS  in ('02','03')
        <if test="keylist != null and keylist.size() > 0">
            AND PROD_ID||'|'||TRADE_CODE||'|'||ASSET_CODE||'|'||CUR_ASSET_TYPE IN
            <trim suffixOverrides=" OR PROD_ID||'|'||TRADE_CODE||'|'||ASSET_CODE||'|'||CUR_ASSET_TYPE IN ()">
                <foreach collection='keylist' open='(' close=')' index='index'
                         item='item'>

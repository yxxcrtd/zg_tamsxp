    <sql id="Base_Column_List" >
    REGIST_SEQNO, PROD_REGIST_CODE, PROD_ID, RAISE_VDATE, RAISE_ENDDATE, PRD_VDATE, PRD_MDATE,
    IS_CONSTRACTE, GRADE_TYPE, EXP_MIN_YIELD, EXP_MAX_YIELD, EXP_AVG_YIELD, YIELD_COMMENT,
    OPEN_MODE, OPEN_CIRCLE, OPEN_CIRCLE_DAYS, RULE_COMMENT, FIRST_OPEN_DAY, HOLIDAY_ON_FLAG,

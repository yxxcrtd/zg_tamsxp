  </sql>
    <select id="selcteDataByIds" parameterType="java.util.List" resultMap="SdProdPersonIssueDtoRM">
        select
        <include refid="Base_Column_List" />
        from CHB_PRD_ISSUE_SUB
        where SEND_STATUS = '01'
        AND STATUS = '01'
        <!--AND   to_char(STATUS_DATE,'yyyy-MM-dd') = #{batchdate,jdbcType = VARCHAR}-->
        <if test="prodIdList != null and prodIdList.size() > 0">
            AND PROD_ID IN
            <trim suffixOverrides=" OR PROD_ID IN ()">
                <foreach collection='prodIdList' open='(' close=')' index='index'
                         item='item'>
                    <if test="index != 0">
                        <choose>
                            <when test="index % 1000 == 999">) OR PROD_ID IN (</when>
                            <otherwise>,</otherwise>
                        </choose>
                    </if>
                    #{item}
                </foreach>
            </trim>
        </if>
    </select>
